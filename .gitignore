# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/\.open-next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.dev.vars*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# antigravity & temporary
.gemini/
.antigravity/
AGENTS.md
CLAUDE.md
.cursorrules
.cursor/
*.mjs
*.sql
*.json
!package.json
!tsconfig.json
!cv.json
!next.config.js
!next.config.ts

# large media / icons (optional but good if they are raw assets)
*.png
*.jpg
*.jpeg
*.webp
!public/*.png
!public/*.jpg
!public/*.jpeg
!public/*.webp
!public/**/*.png
!public/**/*.jpg
!public/**/*.jpeg
!public/**/*.webp
!src/app/*.png
!src/app/apple-icon.png
!src/app/icon.png
!ico.png

# local backups
*.bak
*.zip
*~

# sensitive local files & data
.env.local
*.py
*.JPG
info.html
pg_client/
al_mikhlafi_videos/
.venv_downloader/
WhatsApp Unknown*

# scratch scripts
scratch/
pass.txt
coolify-creds.txt

# Keep reviewed Supabase migrations in version control.
!supabase/
!supabase/migrations/
!supabase/migrations/*.sql
